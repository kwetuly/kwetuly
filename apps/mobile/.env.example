# Example settings for the app. Real values (Supabase URL and key) go in .env.local, never here.

# "Connected sign-ins" (Account tab): set to 1 only after manual linking is switched on in
# Supabase (Authentication > Sign In / Providers > Allow manual linking). Until then the Connect and
# Remove buttons stay hidden. Walter sets this in EAS.
EXPO_PUBLIC_LINKING_ON=0
