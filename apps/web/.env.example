# Example settings for the website. Real values (Supabase keys, secrets) go in .env.local, never here.

# "Connected sign-ins" (security page): set to 1 only after manual linking is switched on in
# Supabase (Authentication > Sign In / Providers > Allow manual linking). Until then the Connect and
# Remove buttons stay hidden. Walter sets this in Vercel.
NEXT_PUBLIC_LINKING_ON=0
