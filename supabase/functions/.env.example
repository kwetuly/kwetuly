# Names of the Edge Function secrets. NEVER put real values here.
# Production and test projects: Supabase dashboard -> Edge Functions -> Secrets.
# Local `supabase functions serve`: copy to supabase/functions/.env (git-ignored) with TEST keys only.

# identifiers (NIDA, passport, TIN). Each key: 32 random bytes, base64, e.g. `openssl rand -base64 32`.
# Walter keeps a copy of every key in his password manager: losing a key loses every number under it.
IDENTIFIER_ENC_KEY_V1=
IDENTIFIER_ENC_KEY_ACTIVE=1
IDENTIFIER_HMAC_KEY_V1=
IDENTIFIER_HMAC_KEY_ACTIVE=1
# Website origins allowed to call the function from the browser (comma-separated).
IDENTIFIERS_ALLOWED_ORIGINS=https://kwetuly.com

# verification-sweep: random secret of at least 32 characters (e.g. `openssl rand -base64 48`), also
# stored in Vault as `verification_sweep_key`. Shorter secrets make the function refuse to run.
VERIFICATION_SWEEP_SECRET=

# payments. Without all of these the payments function stays switched off (config answers enabled: false).

# Must be exactly "flutterwave". Selcom is parked; any other value keeps payments off.
PAYMENTS_PROVIDER=flutterwave
# Must be "test". Live is refused by this build until Walter approves live keys and the live switch.
KWETULY_ENV=test
# Flutterwave dashboard (test mode), Settings, API keys: the TEST secret key (starts with FLWSECK_TEST-).
FLW_SECRET_KEY=
# The ONE webhook scheme the Flutterwave account uses: v3 (header verif-hash) or v4 (header flutterwave-signature).
FLW_WEBHOOK_MODE=
# v3 only: the "secret hash" you choose in Settings, Webhooks. At least 32 random characters.
FLW_SECRET_HASH=
# v4 only: the webhook signing secret. At least 32 characters, never the same as FLW_SECRET_HASH.
FLW_WEBHOOK_SIGNING_SECRET=
# Shillings per US dollar used to price deposits, e.g. 2600 or 2650.75, and where that rate comes from.
USD_TZS_RATE=
USD_TZS_RATE_SOURCE=
# At least 32 random characters; the same value goes into Vault as payments_sweep_secret
# (see supabase/migrations/20261122100000_flutterwave_provider.sql).
PAYMENTS_SWEEP_SECRET=
# Required, no default: the TEST site travellers come back to (https, or http://localhost:3000).
# The live site (https://kwetuly.com) is refused while KWETULY_ENV=test.
SITE_URL=
