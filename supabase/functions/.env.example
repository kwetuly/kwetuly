# Secret NAMES for the Supabase Edge Functions (payments). Never put real values in this file or the repo.
# Real values go only into the Supabase TEST project: Dashboard, Edge Functions, Secrets (Walter or devops),
# or into a local, git-ignored supabase/functions/.env for `supabase functions serve`.
# Without all of them the payments function stays switched off (config answers enabled: false).

# Must be exactly "flutterwave". Selcom is parked; any other value keeps payments off.
PAYMENTS_PROVIDER=flutterwave
# Must be "test". Live is refused by this build until Walter approves live keys and the live switch.
KWETULY_ENV=test
# Flutterwave dashboard (test mode), Settings, API keys: the TEST secret key (starts with FLWSECK_TEST-).
FLW_SECRET_KEY=
# Flutterwave dashboard (test mode), Settings, Webhooks: the "secret hash" you choose there.
# At least 32 random characters (e.g. openssl rand -hex 32). The same value in both places.
FLW_SECRET_HASH=
# Shillings per US dollar used to price deposits, e.g. 2600 or 2650.75, and where that rate comes from.
USD_TZS_RATE=
USD_TZS_RATE_SOURCE=
# At least 32 random characters; the same value goes into Vault as payments_sweep_secret
# (see supabase/migrations/20261122100000_flutterwave_provider.sql).
PAYMENTS_SWEEP_SECRET=
# Where travellers come back to after paying.
SITE_URL=https://kwetuly.com
